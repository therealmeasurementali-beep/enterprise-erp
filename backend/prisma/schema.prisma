generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String
  role         String          @default("Accounts") // Admin, Sales, Warehouse, Accounts
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  followUps      FollowUp[]
  stockMovements StockMovement[]
  salesChallans  SalesChallan[]
}

model Customer {
  id           String          @id @default(uuid())
  name         String
  mobile       String
  email        String?
  businessName String?
  gstNumber    String?
  type         String          @default("Retail") // Retail, Wholesale, Distributor
  address      String?
  status       String          @default("Lead") // Lead, Active, Inactive
  followUpDate DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  followUps    FollowUp[]
  challans     SalesChallan[]
}

model FollowUp {
  id         String   @id @default(uuid())
  customerId String
  userId     String
  notes      String
  date       DateTime
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
  assignedTo User     @relation(fields: [userId], references: [id])
}

model Product {
  id                    String          @id @default(uuid())
  name                  String
  sku                   String          @unique
  category              String?
  unitPrice             Float
  currentStock          Int             @default(0)
  minStockAlertQuantity Int             @default(10)
  location              String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  movements             StockMovement[]
  challanItems          ChallanItem[]
}

model StockMovement {
  id              String   @id @default(uuid())
  productId       String
  quantityChanged Int
  type            String   // IN, OUT
  reason          String?
  createdBy       String
  timestamp       DateTime @default(now())

  product         Product  @relation(fields: [productId], references: [id])
  user            User     @relation(fields: [createdBy], references: [id])
}

model SalesChallan {
  id            String          @id @default(uuid())
  challanNumber String          @unique
  customerId    String
  totalQuantity Int             @default(0)
  status        String          @default("Draft") // Draft, Confirmed, Cancelled
  createdBy     String
  createdDate   DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  customer      Customer        @relation(fields: [customerId], references: [id])
  user          User            @relation(fields: [createdBy], references: [id])
  items         ChallanItem[]
}

model ChallanItem {
  id                  String       @id @default(uuid())
  challanId           String
  productId           String
  productNameSnapshot String
  skuSnapshot         String
  unitPriceSnapshot   Float
  quantity            Int
  
  challan             SalesChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product             Product      @relation(fields: [productId], references: [id])
}
